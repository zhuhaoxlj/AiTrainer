<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.xuexiang.xui.widget.actionbar.TitleBar
        android:id="@+id/profileTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tb_actionPadding="20dp"
        app:tb_sideTextPadding="20dp"
        app:tb_titleText="编辑简介" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/nickNameHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="30dp"
            android:text="@string/profileHint"
            android:textColor="#A8A8AA"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/profileEditText"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@id/nickNameHint"
            android:layout_marginStart="5dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="15dp"
            android:background="@color/xui_transparent"
            android:gravity="top"
            android:hint="@string/inputProfileTips"
            android:inputType="textMultiLine"
            android:maxLength="160"
            android:text=""
            android:textSize="18sp"
            tools:ignore="TextFields" />

        <TextView
            android:id="@+id/profileTextLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="15dp"
            android:text="@string/profileTextLimit"
            android:textColor="#A8A8AA"
            android:textSize="15sp" />
    </RelativeLayout>
</LinearLayout>