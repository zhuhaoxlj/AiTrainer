<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/v_bg"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <!-- 动作库 -->
        <LinearLayout
            android:id="@+id/ll_pose_library"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/v_bg"
            app:layout_constraintEnd_toStartOf="@+id/tab_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_bg">

            <ImageView
                android:id="@+id/iv_pose_library"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pose_library" />

            <TextView
                android:id="@+id/tv_pose_library"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="动作库"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 中间大图标 -->
        <LinearLayout
            android:id="@+id/tab_center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:id="@+id/center_icon_container"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="28dp">

                <View
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_black" />

                <ImageView
                    android:id="@+id/iv_center"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_training"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <!-- 数据 -->
        <LinearLayout
            android:id="@+id/ll_diary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/v_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tab_center"
            app:layout_constraintTop_toTopOf="@+id/v_bg">

            <ImageView
                android:id="@+id/iv_diary"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_diary" />

            <TextView
                android:id="@+id/tv_diary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="日记"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>